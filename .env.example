# Copy to .env and fill in. Never commit .env.

# Zerodha Kite Connect (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=
# Redirect URL registered on the Kite developer console, e.g. https://<your-server>/kite/callback
KITE_REDIRECT_URL=

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Your personal chat id; only this chat may control the bot
TELEGRAM_CHAT_ID=

# Engine
# paper = simulate orders, live = place real orders
TRADING_MODE=paper
# mock = fake price feed for development, kite = live Kite WebSocket
PRICE_FEED=mock

# Risk limits (rupees)
MAX_CAPITAL_PER_TRADE=10000
MAX_DAILY_LOSS=2000
MAX_OPEN_POSITIONS=3

DATABASE_URL=sqlite:///./data/algo.db
